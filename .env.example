# Common Environment Configuration
ENVIRONMENT=development
JWT_SECRET=super_secret_jwt_key_change_in_production_12345!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Database Configurations (Isolated per service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AUTH_DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/auth_db
CATALOG_DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/catalog_db
INVENTORY_DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/inventory_db
CHECKOUT_DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/checkout_db

# Microservices URLs for Gateway Routing
AUTH_SERVICE_URL=http://gateway_auth:8001
CATALOG_SERVICE_URL=http://catalog_service:8002
INVENTORY_SERVICE_URL=http://inventory_service:8003
CHECKOUT_SERVICE_URL=http://checkout_service:8004
